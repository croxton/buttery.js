{
  "name": "@croxton/buttery",
  "version": "1.0.1",
  "description": "Lightweight, performance-focused scroll animation library using native scroll timelines with a JS fallback",
  "type": "module",
  "files": [
    "dist",
    "lib"
  ],
  "main": "./dist/buttery.cjs",
  "module": "./dist/buttery.js",
  "unpkg": "./dist/buttery.min.js",
  "jsdelivr": "./dist/buttery.min.js",
  "exports": {
    ".": {
      "import": "./dist/buttery.js",
      "require": "./dist/buttery.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode browser",
    "demo": "vite --open /demo/",
    "test": "vitest",
    "prepublishOnly": "npm run build && publint",
    "test:browser": "vitest --config vitest.browser.config.js"
  },
  "dependencies": {
    "eases": "^1.0.8",
    "parse-unit": "^1.0.1"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
